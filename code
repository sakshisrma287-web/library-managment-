/*
    ============================================================
     LIBRARY MANAGEMENT SYSTEM
    ============================================================
    A console-based Library Management System built using
    Object-Oriented Programming in C++.

    Features:
      - Add / manage Book records
      - Add / manage Member records
      - Issue a book to a member
      - Return a book from a member
      - Search books by Title or Author
      - View all books, all members, and currently issued books
      - Persist data to text files (books.txt, members.txt, issued.txt)

    Compile:
      g++ -std=c++17 -o library library_management_system.cpp
    Run:
      ./library
    ============================================================
*/

#include <iostream>
#include <fstream>
#include <sstream>
#include <vector>
#include <string>
#include <algorithm>
#include <limits>
#include <iomanip>

using namespace std;

// ------------------------------------------------------------
// Utility helpers
// ------------------------------------------------------------
string toLower(const string &s) {
    string result = s;
    transform(result.begin(), result.end(), result.begin(), ::tolower);
    return result;
}

bool containsIgnoreCase(const string &haystack, const string &needle) {
    return toLower(haystack).find(toLower(needle)) != string::npos;
}

int readInt(const string &prompt) {
    int value;
    while (true) {
        cout << prompt;
        if (cin >> value) {
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            return value;
        }
        cout << "Invalid input. Please enter a number.\n";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }
}

string readLine(const string &prompt) {
    string value;
    cout << prompt;
    getline(cin, value);
    return value;
}

// ------------------------------------------------------------
// Book class
// ------------------------------------------------------------
class Book {
public:
    int bookId;
    string title;
    string author;
    int totalCopies;
    int availableCopies;

    Book() : bookId(0), totalCopies(0), availableCopies(0) {}

    Book(int id, string t, string a, int total, int available)
        : bookId(id), title(move(t)), author(move(a)),
          totalCopies(total), availableCopies(available) {}

    string toFileString() const {
        ostringstream oss;
        oss << bookId << "|" << title << "|" << author << "|"
            << totalCopies << "|" << availableCopies;
        return oss.str();
    }

    static Book fromFileString(const string &line) {
        stringstream ss(line);
        string idStr, title, author, totalStr, availStr;
        getline(ss, idStr, '|');
        getline(ss, title, '|');
        getline(ss, author, '|');
        getline(ss, totalStr, '|');
        getline(ss, availStr, '|');
        return Book(stoi(idStr), title, author, stoi(totalStr), stoi(availStr));
    }

    void display() const {
        cout << left << setw(6) << bookId
             << setw(30) << title
             << setw(20) << author
             << setw(8) << totalCopies
             << setw(10) << availableCopies << "\n";
    }
};

// ------------------------------------------------------------
// Member class
// ------------------------------------------------------------
class Member {
public:
    int memberId;
    string name;
    string contact;

    Member() : memberId(0) {}

    Member(int id, string n, string c)
        : memberId(id), name(move(n)), contact(move(c)) {}

    string toFileString() const {
        ostringstream oss;
        oss << memberId << "|" << name << "|" << contact;
        return oss.str();
    }

    static Member fromFileString(const string &line) {
        stringstream ss(line);
        string idStr, name, contact;
        getline(ss, idStr, '|');
        getline(ss, name, '|');
        getline(ss, contact, '|');
        return Member(stoi(idStr), name, contact);
    }

    void display() const {
        cout << left << setw(6) << memberId
             << setw(25) << name
             << setw(15) << contact << "\n";
    }
};

// ------------------------------------------------------------
// IssueRecord class - links a Book to a Member
// ------------------------------------------------------------
class IssueRecord {
public:
    int bookId;
    int memberId;
    string issueDate; // simple string date, e.g. entered by user

    IssueRecord() : bookId(0), memberId(0) {}

    IssueRecord(int bId, int mId, string date)
        : bookId(bId), memberId(mId), issueDate(move(date)) {}

    string toFileString() const {
        ostringstream oss;
        oss << bookId << "|" << memberId << "|" << issueDate;
        return oss.str();
    }

    static IssueRecord fromFileString(const string &line) {
        stringstream ss(line);
        string bStr, mStr, date;
        getline(ss, bStr, '|');
        getline(ss, mStr, '|');
        getline(ss, date, '|');
        return IssueRecord(stoi(bStr), stoi(mStr), date);
    }
};

// ------------------------------------------------------------
// Library class - manages all data and operations
// ------------------------------------------------------------
class Library {
private:
    vector<Book> books;
    vector<Member> members;
    vector<IssueRecord> issuedRecords;

    const string BOOKS_FILE = "books.txt";
    const string MEMBERS_FILE = "members.txt";
    const string ISSUED_FILE = "issued.txt";

    int nextBookId() const {
        int maxId = 0;
        for (const auto &b : books) maxId = max(maxId, b.bookId);
        return maxId + 1;
    }

    int nextMemberId() const {
        int maxId = 0;
        for (const auto &m : members) maxId = max(maxId, m.memberId);
        return maxId + 1;
    }

    Book* findBookById(int id) {
        for (auto &b : books) if (b.bookId == id) return &b;
        return nullptr;
    }

    Member* findMemberById(int id) {
        for (auto &m : members) if (m.memberId == id) return &m;
        return nullptr;
    }

public:
    Library() {
        loadBooks();
        loadMembers();
        loadIssuedRecords();
    }

    // ---------------- File I/O ----------------
    void loadBooks() {
        books.clear();
        ifstream file(BOOKS_FILE);
        string line;
        while (getline(file, line)) {
            if (!line.empty()) books.push_back(Book::fromFileString(line));
        }
    }

    void saveBooks() const {
        ofstream file(BOOKS_FILE);
        for (const auto &b : books) file << b.toFileString() << "\n";
    }

    void loadMembers() {
        members.clear();
        ifstream file(MEMBERS_FILE);
        string line;
        while (getline(file, line)) {
            if (!line.empty()) members.push_back(Member::fromFileString(line));
        }
    }

    void saveMembers() const {
        ofstream file(MEMBERS_FILE);
        for (const auto &m : members) file << m.toFileString() << "\n";
    }

    void loadIssuedRecords() {
        issuedRecords.clear();
        ifstream file(ISSUED_FILE);
        string line;
        while (getline(file, line)) {
            if (!line.empty()) issuedRecords.push_back(IssueRecord::fromFileString(line));
        }
    }

    void saveIssuedRecords() const {
        ofstream file(ISSUED_FILE);
        for (const auto &r : issuedRecords) file << r.toFileString() << "\n";
    }

    // ---------------- Book management ----------------
    void addBook() {
        string title = readLine("Enter book title: ");
        string author = readLine("Enter author name: ");
        int copies = readInt("Enter number of copies: ");

        int id = nextBookId();
        books.emplace_back(id, title, author, copies, copies);
        saveBooks();
        cout << "Book added successfully with ID: " << id << "\n";
    }

    void viewAllBooks() const {
        if (books.empty()) {
            cout << "No books in the library yet.\n";
            return;
        }
        cout << "\n" << left << setw(6) << "ID" << setw(30) << "Title"
             << setw(20) << "Author" << setw(8) << "Total" << setw(10) << "Available" << "\n";
        cout << string(74, '-') << "\n";
        for (const auto &b : books) b.display();
    }

    // ---------------- Member management ----------------
    void addMember() {
        string name = readLine("Enter member name: ");
        string contact = readLine("Enter contact (phone/email): ");

        int id = nextMemberId();
        members.emplace_back(id, name, contact);
        saveMembers();
        cout << "Member added successfully with ID: " << id << "\n";
    }

    void viewAllMembers() const {
        if (members.empty()) {
            cout << "No members registered yet.\n";
            return;
        }
        cout << "\n" << left << setw(6) << "ID" << setw(25) << "Name" << setw(15) << "Contact" << "\n";
        cout << string(46, '-') << "\n";
        for (const auto &m : members) m.display();
    }

    // ---------------- Issue / Return ----------------
    void issueBook() {
        if (books.empty() || members.empty()) {
            cout << "Please make sure at least one book and one member exist first.\n";
            return;
        }

        int bookId = readInt("Enter Book ID to issue: ");
        Book *book = findBookById(bookId);
        if (!book) {
            cout << "Book not found.\n";
            return;
        }
        if (book->availableCopies <= 0) {
            cout << "No available copies of \"" << book->title << "\" right now.\n";
            return;
        }

        int memberId = readInt("Enter Member ID: ");
        Member *member = findMemberById(memberId);
        if (!member) {
            cout << "Member not found.\n";
            return;
        }

        string date = readLine("Enter issue date (e.g. 2026-08-24): ");

        book->availableCopies--;
        issuedRecords.emplace_back(bookId, memberId, date);

        saveBooks();
        saveIssuedRecords();

        cout << "Book \"" << book->title << "\" issued to " << member->name << " successfully.\n";
    }

    void returnBook() {
        int bookId = readInt("Enter Book ID to return: ");
        int memberId = readInt("Enter Member ID: ");

        auto it = find_if(issuedRecords.begin(), issuedRecords.end(),
            [&](const IssueRecord &r) {
                return r.bookId == bookId && r.memberId == memberId;
            });

        if (it == issuedRecords.end()) {
            cout << "No matching issue record found for this book and member.\n";
            return;
        }

        Book *book = findBookById(bookId);
        if (book) {
            book->availableCopies++;
            saveBooks();
        }

        issuedRecords.erase(it);
        saveIssuedRecords();

        cout << "Book returned successfully.\n";
    }

    void viewIssuedBooks() const {
        if (issuedRecords.empty()) {
            cout << "No books are currently issued.\n";
            return;
        }

        cout << "\n" << left << setw(6) << "BookID" << setw(30) << "Title"
             << setw(6) << "MemID" << setw(20) << "Member" << setw(12) << "Issue Date" << "\n";
        cout << string(74, '-') << "\n";

        for (const auto &r : issuedRecords) {
            string title = "Unknown", memberName = "Unknown";
            for (const auto &b : books) if (b.bookId == r.bookId) title = b.title;
            for (const auto &m : members) if (m.memberId == r.memberId) memberName = m.name;

            cout << left << setw(6) << r.bookId << setw(30) << title
                 << setw(6) << r.memberId << setw(20) << memberName
                 << setw(12) << r.issueDate << "\n";
        }
    }

    // ---------------- Search ----------------
    void searchBooks() const {
        cout << "\nSearch by:\n1. Title\n2. Author\n";
        int choice = readInt("Enter choice: ");

        string keyword = readLine("Enter search keyword: ");
        bool found = false;

        cout << "\n" << left << setw(6) << "ID" << setw(30) << "Title"
             << setw(20) << "Author" << setw(8) << "Total" << setw(10) << "Available" << "\n";
        cout << string(74, '-') << "\n";

        for (const auto &b : books) {
            bool match = (choice == 1) ? containsIgnoreCase(b.title, keyword)
                                        : containsIgnoreCase(b.author, keyword);
            if (match) {
                b.display();
                found = true;
            }
        }

        if (!found) cout << "No matching books found.\n";
    }
};

// ------------------------------------------------------------
// Menu-driven main function
// ------------------------------------------------------------
void printMenu() {
    cout << "\n==================== LIBRARY MANAGEMENT SYSTEM ====================\n";
    cout << "1.  Add Book\n";
    cout << "2.  View All Books\n";
    cout << "3.  Add Member\n";
    cout << "4.  View All Members\n";
    cout << "5.  Issue Book\n";
    cout << "6.  Return Book\n";
    cout << "7.  View Issued Books\n";
    cout << "8.  Search Books (by Title/Author)\n";
    cout << "9.  Exit\n";
    cout << "=====================================================================\n";
}

int main() {
    Library library;
    bool running = true;

    cout << "Welcome to the Library Management System\n";

    while (running) {
        printMenu();
        int choice = readInt("Enter your choice: ");

        switch (choice) {
            case 1: library.addBook(); break;
            case 2: library.viewAllBooks(); break;
            case 3: library.addMember(); break;
            case 4: library.viewAllMembers(); break;
            case 5: library.issueBook(); break;
            case 6: library.returnBook(); break;
            case 7: library.viewIssuedBooks(); break;
            case 8: library.searchBooks(); break;
            case 9:
                cout << "Thank you for using the Library Management System. Goodbye!\n";
                running = false;
                break;
            default:
                cout << "Invalid choice. Please select a valid option (1-9).\n";
        }
    }

    return 0;
}
